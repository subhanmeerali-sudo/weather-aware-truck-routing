# copy me to backend/.env and change stuff
DJANGO_SECRET_KEY=change-me-to-something-long-and-random
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# dev: allow everything. prod: set CORS_ALLOW_ALL=false and list your frontend
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nominatim REQUIRES a real identifying User-Agent (generic ones get 403)
NOMINATIM_USER_AGENT=SpotterWeatherTruckRouting/1.0 (your-email@example.com)
# optional: limit geocoding to countries, e.g. us,ca
NOMINATIM_COUNTRY_CODES=
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=20
# OSRM public server is car-only. 1.0 = trust it; 1.1 = trucks are 10% slower
TRUCK_DURATION_FACTOR=1.0
API_RATE_LIMIT=30/min
